# Portfolio: static files, rendered by Caddy's built-in templates (no build step).
# The container serves site/ from /srv on :8080; the infra Caddy in front of it does TLS.
#
# Pages are plain HTML that pull shared pieces from site/_partials/ and data from
# site/content/. A project page is one Markdown file: site/content/work/<slug>.md
# renders at /work/<slug>/ through site/work/_project.html. See CLAUDE.md.
{
	admin off
	persist_config off
}

:{$PORT:8080} {
	root * {$SITE_ROOT:/srv}
	encode zstd gzip

	# Old URLs from the first version of the site.
	redir /index.html / 301
	redir /project-ssociety.html /work/ssociety/ 301
	redir /project-notes.html /work/notes/ 301

	# Partials, content sources and the project template are never served directly.
	# (Checked against the original URL, so the internal rewrite below still works.)
	@private expression `{http.request.orig_uri.path}.startsWith("/_partials/") || {http.request.orig_uri.path}.startsWith("/content/") || {http.request.orig_uri.path}.startsWith("/work/_")`
	respond @private 404

	# /work/<slug> → /work/<slug>/ → the project template, which 404s unknown slugs itself.
	@projectNoSlash path_regexp projectNoSlash ^/work/([a-z0-9-]+)$
	redir @projectNoSlash /work/{re.projectNoSlash.1}/ 308
	@project path_regexp project ^/work/([a-z0-9-]+)/$
	rewrite @project /work/_project.html

	templates {
		mime text/html application/xml text/plain
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy same-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self' mailto:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		-Server
	}
	# HTML always revalidates; versioned assets are immutable; media for a week.
	@html path / *.html */
	header @html Cache-Control "no-cache"
	@versioned query v=*
	header @versioned Cache-Control "public, max-age=31536000, immutable"
	@media path /assets/work/* /assets/img/* /assets/fonts/* /files/*
	header @media Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

	try_files {path} {path}/index.html {path}.html
	file_server

	handle_errors {
		rewrite * /404.html
		templates
		file_server {
			status 404
		}
	}
}
